# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development               # development | staging | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-32-bytes-random-string

# ── Database (PostgreSQL + pgvector via Supabase) ─────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/drama_factory
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-very-long-random-secret-key-for-jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Anthropic / Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Avatar & Voice ────────────────────────────────────────────────────────────
HEYGEN_API_KEY=your-heygen-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ── LangSmith (observability) ─────────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=drama-factory
LANGCHAIN_TRACING_V2=true

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
